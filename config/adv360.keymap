#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"
      #ifndef VERSION_MACRO

        macro_ver: macro_ver {
            compatible = "zmk,behavior-macro";
            label = "macro_version";
            #binding-cells = <0>;
            bindings = <&kp RET>;
        };

        copy: copy {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(C)>;
            label = "COPY";
        };

        paste: paste {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(V)>;
            label = "PASTE";
        };

        cut: cut {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(X)>;
            label = "CUT";
        };

        #endif

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
    };

    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &tog 1                                                                                     &tog 1         &kp N6  &kp N7  &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &kp LS(LCTRL)                                                                              &kp RA(RCTRL)  &kp Y   &kp U   &kp I      &kp O     &kp P     &kp BSLH
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &kp LS(LALT)   &kp LCTRL  &kp LALT                     &kp RALT                 &kp RCTRL  &kp LS(LALT)   &kp H   &kp J   &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                             &mt LS(LA(LC(LGUI))) F5      &mt LS(LA(LC(LGUI))) F5                            &kp N   &kp M   &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
&sl 3      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC       &kp DEL    &kp LGUI                     &kp RGUI                 &kp ENTER  &kp SPACE              &kp UP  &kp DOWN   &kp LBKT  &kp RBKT  &mo 3
            >;
        };

        Colemak {
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3          &kp N4           &kp N5  &to 0                                                                                          &tog 0            &kp N6  &kp N7        &kp N8          &kp N9    &kp N0    &kp MINUS
&kp TAB    &kp Q      &kp W     &kp F           &kp P            &kp G   &kp LS(LCTRL)                                                                                  &kp LS(LCTRL)     &kp J   &kp L         &kp U           &kp Y     &kp SEMI  &kp BSLH
&kp ESC    &kp A      &kp R     &kp S           &kp T            &kp D   &kp LS(LEFT_ALT)  &kp LCTRL   &kp LEFT_ALT                     &kp LEFT_ALT         &kp RCTRL  &kp LS(LEFT_ALT)  &kp H   &kp N         &kp E           &kp I     &kp O     &kp APOS
&kp LSHFT  &kp Z      &kp X     &kp C           &kp V            &kp B                                 &mt LS(LA(LC(LEFT_GUI))) F5      &mt LA(LC(LGUI)) F5                               &kp K   &kp M         &kp COMMA       &kp DOT   &kp FSLH  &kp RSHFT
&mo 3      &kp GRAVE  &kp CAPS  &kp LEFT_ARROW  &kp RIGHT_ARROW          &kp BACKSPACE     &kp DELETE  &kp LEFT_GUI                     &kp RIGHT_GUI        &kp ENTER  &kp SPACE                 &kp UP_ARROW  &kp DOWN_ARROW  &kp LBKT  &kp RBKT  &mo 4
            >;
        };

        keypad {
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &trans                                                   &mo 5      &kp N6  &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                                    &none      &kp Y   &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &kp BSLH
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &none     &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none      &kp H   &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                        &kp HOME      &kp PG_UP                        &kp N   &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &kp RSHFT
&mo 3      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &kp KP_N0          &kp UP      &kp DOWN      &kp KP_DOT     &kp RBKT         &mo 3
            >;
        };

        fn {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4            &kp F5             &kp F6        &tog 3                                              &mo 5   &kp F7           &kp F8         &kp F9            &kp F10           &kp F11        &kp F12
&trans  &trans  &trans  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp CARET     &none                                               &none   &kp EXCLAMATION  &kp LESS_THAN  &kp GREATER_THAN  &trans            &trans         &trans
&trans  &trans  &trans  &kp LEFT_BRACE    &kp RIGHT_BRACE    &kp ASTERISK  &none   &trans  &trans          &bt BT_CLR  &trans  &none   &kp H            &kp J          &kp K             &kp L             &kp SEMICOLON  &trans
&trans  &trans  &trans  &trans            &trans             &trans                        &trans          &trans                      &trans           &trans         &none             &kp GREATER_THAN  &trans         &trans
&trans  &trans  &trans  &trans            &trans                           &trans  &trans  &bt BT_NXT      &trans      &trans  &trans                   &trans         &trans            &trans            &trans         &trans
            >;
        };

        mod {
            bindings = <
&none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans                  &none  &none       &none       &none  &none  &none
&none  &none         &none         &none         &none         &none         &bootloader                                            &bootloader             &none  &none       &none       &none  &none  &none
&none  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &rgb_ug RGB_MEFS_CMD 5  &none  &none       &none       &none  &none  &none
&none  &none         &none         &none         &macro_ver    &none                             &none      &none                                           &none  &none       &none       &none  &none  &none
&none  &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG                &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
